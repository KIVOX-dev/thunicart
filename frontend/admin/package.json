    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
