{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "vite",
      "buildCommand": "VITE_BASE=/admin/ pnpm build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/admin/:path*", "destination": "/admin/index.html" }
      ]
    },
    "storefront": {
      "root": "storefront",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": { "service": "admin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "storefront" }
    }
  ]
}
