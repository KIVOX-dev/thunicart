{
  "name": "@thunikart/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./api-client": "./src/api-client/index.ts"
  },
  "scripts": {
    "generate-client": "openapi-typescript ../docs/api/openapi.json -o src/api-client/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "build": "echo shared is consumed as TypeScript source"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}