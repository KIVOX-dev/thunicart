{
  "name": "thunikart",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "docker compose up --build",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "openapi": "pnpm --filter @thunikart/backend openapi && pnpm --filter @thunikart/shared generate-client",
    "seed": "pnpm --filter @thunikart/backend seed",
    "deploy-backend": "node deploy/deploy-backend.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
