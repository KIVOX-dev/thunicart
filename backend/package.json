{
  "name": "@thunikart/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test seed scripts",
    "test": "vitest run",
    "seed": "tsx seed/run.ts",
    "openapi": "tsx src/openapi/generate.ts",
    "migrate": "tsx scripts/migrate.ts",
    "dev:db": "tsx scripts/dev-db.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@thunikart/shared": "workspace:*",
    "argon2": "^0.43.0",
    "fastify": "^5.3.0",
    "jose": "^6.0.0",
    "migrate-mongo": "^12.0.0",
    "mongoose": "^8.15.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "mongodb-memory-server": "^10.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
